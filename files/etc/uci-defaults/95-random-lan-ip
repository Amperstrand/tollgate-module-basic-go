#!/bin/sh
# TollGate - Derive deterministic LAN IP from MAC address on first boot
#
# If the LAN IP is the OpenWrt default (192.168.1.1), derive a deterministic
# IP in the 10.x.x.1/24 range from the device's MAC address using MD5 hash.
# This ensures:
# - Same device always gets the same IP across reflashes/factory resets
# - No collisions with ISP routers (typically 192.168.1.1)
# - Predictable IP — can be pre-calculated from MAC before flashing
#
# If the IP is NOT 192.168.1.1 (user deliberately set it), preserve it.
#
# Algorithm matches conwrt's mac_hash.py for cross-tool consistency.

FLAG_FILE="/etc/config/95-random-lan-ip.done"
REBOOT_NEEDED=0

# Check if the script has already been executed
if [ -f "$FLAG_FILE" ]; then
    echo "95-random-lan-ip already executed. Exiting."
    exit 0
else
    REBOOT_NEEDED=1
fi

# Check current LAN IP address
CURRENT_IP=$(uci -q get network.lan.ipaddr)

# If IP is already non-default, exit — respect the user's choice
if [ "$CURRENT_IP" != "192.168.1.1" ]; then
    echo "LAN IP is $CURRENT_IP (non-default) — preserving. Exiting."
    touch "$FLAG_FILE"
    REBOOT_NEEDED=0
    exit 0
fi

echo "LAN IP is 192.168.1.1 (OpenWrt default) — deriving deterministic IP from MAC"

# Read MAC from br-lan (carries factory base MAC on DSA devices)
# Fall back to eth0 if br-lan doesn't exist (initramfs, DSA setup incomplete)
MAC=$(cat /sys/class/net/br-lan/address 2>/dev/null)
if [ -z "$MAC" ]; then
    MAC=$(cat /sys/class/net/eth0/address 2>/dev/null)
fi

if [ -z "$MAC" ]; then
    echo "WARNING: Could not read MAC address — keeping 192.168.1.1"
    touch "$FLAG_FILE"
    exit 1
fi

echo "Device MAC: $MAC"

# Derive two subnet octets from SHA-256 hash of MAC
# Matches conwrt's mac_hash.py: mac_to_subnet_octets()
#
# SHA-256 hash of cleaned MAC (no colons), first 8 hex chars → octet 2 (1-250),
# next 8 hex chars → octet 3 (1-250). Always 10.x.x.1/24.
MAC_CLEAN=$(printf '%s' "$MAC" | tr -d ':')
HASH=$(printf '%s' "$MAC_CLEAN" | sha256sum)
OCTET2=$(printf '%d' 0x$(printf '%s' "$HASH" | cut -c1-8))
OCTET2=$((OCTET2 % 250 + 1))
OCTET3=$(printf '%d' 0x$(printf '%s' "$HASH" | cut -c9-16))
OCTET3=$((OCTET3 % 250 + 1))

DERIVED_IP="10.$OCTET2.$OCTET3.1"
echo "Derived LAN IP: $DERIVED_IP"

# Update network config
uci set network.lan.ipaddr="$DERIVED_IP"
uci set network.lan.netmask="255.255.255.0"
uci commit network

# Update hosts file
if grep -q "status.client" /etc/hosts; then
    sed -i "s/.*status\.client/$DERIVED_IP status.client/" /etc/hosts
else
    echo "$DERIVED_IP status.client" >> /etc/hosts
fi

# NoDogSplash config check (only if installed)
if [ -f "/etc/config/nodogsplash" ]; then
    echo "NoDogSplash detected — config will use updated IP automatically"
fi

# Create flag file to indicate script has been executed
touch "$FLAG_FILE"

if [ "$REBOOT_NEEDED" -eq 1 ]; then
    (sleep 5 && reboot) &
fi
