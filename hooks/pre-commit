#!/usr/bin/env bash
# Pre-commit hook: gitleaks staged scan + dependency sync + stale import paths.
# Install with: git config core.hooksPath hooks
# gitleaks (optional but recommended): go install github.com/zricethezav/gitleaks/v8@v8.30.1
#   — same pinned version as CI; set GITLEAKS_REQUIRED=1 to fail-closed when absent.
set -euo pipefail

# Gitleaks staged scan: secrets are cheap to remove BEFORE the commit and
# expensive after push (history rewrite). Complements, not replaces, the
# CI full-history scan (hooks are bypassable with --no-verify and only
# cover machines with the hook installed).
if command -v gitleaks >/dev/null 2>&1; then
    echo "🔍 gitleaks: scanning staged changes..."
    gitleaks protect --staged --redact --verbose
elif [ -n "${GITLEAKS_REQUIRED:-}" ]; then
    echo "❌ gitleaks not found and GITLEAKS_REQUIRED is set"
    echo "   install: go install github.com/zricethezav/gitleaks/v8@v8.30.1"
    exit 1
else
    echo "⚠️  gitleaks not installed — skipping staged secret scan"
    echo "   install: go install github.com/zricethezav/gitleaks/v8@v8.30.1"
fi

if git diff --cached --name-only | grep -q '\.mod$\|go\.sum$'; then
    echo "🔍 Checking dependency sync across go.mod files..."
    python3 tests/contract/check-deps-sync.py
fi

if git diff --cached --name-only | grep -q '\.go$'; then
    echo "🔍 Checking for stale import paths..."
    python3 tests/contract/check-import-paths.py
fi

# Check gofmt on staged Go files (--diff-filter=d: gofmt cannot read
# deleted files; xargs -I{} keeps one file per line, spaces-safe)
if git diff --cached --name-only | grep -q '\.go$'; then
    unformatted=$(git diff --cached --name-only --diff-filter=d -- '*.go' | xargs -I{} gofmt -l -- {})
    if [ -n "$unformatted" ]; then
        echo "❌ gofmt found unformatted files:"
        echo "$unformatted"
        echo ""
        echo "Run: gofmt -w <files>"
        exit 1
    fi
fi
